CREATE TABLE ssh_authorizations (
	id INTEGER NOT NULL, 
	ssh_account_id INTEGER, 
	ssh_pubkey_id INTEGER, 
	forced_command VARCHAR, 
	update_date INTEGER, 
	PRIMARY KEY (id), 
	FOREIGN KEY(ssh_account_id) REFERENCES ssh_accounts (id), 
	FOREIGN KEY(ssh_pubkey_id) REFERENCES ssh_pubkeys (id)
);
