CREATE TABLE ssh_accounts (
	id INTEGER NOT NULL, 
	user VARCHAR NOT NULL, 
	host VARCHAR NOT NULL, 
	owned_hardware BOOLEAN, 
	use_become BOOLEAN, 
	PRIMARY KEY (id)
);
INSERT INTO ssh_accounts VALUES(1,'user','laptop',1,0);
INSERT INTO ssh_accounts VALUES(2,'root','laptop',1,1);
CREATE TABLE ssh_pubkeys (
	id INTEGER NOT NULL, 
	"user@host" VARCHAR NOT NULL, 
	ssh_pubkey VARCHAR NOT NULL, 
	ssh_pubkey_date INTEGER, 
	is_tpm BOOLEAN, 
	ssh_pubkey_comment VARCHAR, 
	last_applied_to_account_date INTEGER, 
	PRIMARY KEY (id)
);
